{
    "version": "1.9",
    "configurations": [
        {
            "name": "default",
            "id": "conf1",
            "device": "dsPIC33CK256MP502",
            "imagePath": "./out/TamagawaMCU/default.elf",
            "tool": "Simulator",
            "packs": [
                {
                    "name": "dsPIC33CK-MP_DFP",
                    "vendor": "Microchip",
                    "version": "1.15.423"
                }
            ],
            "fileSet": "default",
            "toolchain": "default-XC16"
        }
    ],
    "propertyGroups": [
        {
            "name": "default-XC16",
            "type": "toolchain",
            "provider": "microchip.toolchains:xc16@2.10",
            "properties": {
                "compiler.isolate-each-function": true,
                "compiler.optimization-level": "-O1",
                "compiler.place-data-into-section": true,
                "linker.heap-size": "0",
                "linker.remove-unused-sections": true,
                "compiler++.isolate-each-function": true,
                "compiler++.optimization-level": "-O1",
                "C30.code-model": [
                    "large-code"
                ],
                "compiler.keep-inline": true,
                "compiler.code-model": "large-code",
                "global.common-include-directories": [
                    "TamagawaMCU/mcc",
                    "TamagawaMCU/mcc/user",
                    "TamagawaMCU/mcc/mcc_generated_files"
                ]
            }
        }
    ],
    "fileSets": [
